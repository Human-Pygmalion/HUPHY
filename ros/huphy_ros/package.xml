<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>huphy_ros</name>
  <version>0.1.0</version>
  <description>HUPHY 제어를 ROS 2 노드로 감쌈. huphy 패키지를 고치지 않고 import 만 함.</description>
  <maintainer email="hwagchan@gmail.com">chanhue</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- huphy 는 여기 적을 수 없음. rosdep 이 apt 패키지와 몇몇 pip 패키지만
       아는데 huphy 는 둘 다 아님. 레포 루트에서 `pip install -e .` 를 전제로 함
       (README.md 참조). -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
