        <mxCell id="st" value="Two nodes. Everything they expose is a topic or a service." style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#6b7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="56" width="1100" height="16" as="geometry" /></mxCell>
